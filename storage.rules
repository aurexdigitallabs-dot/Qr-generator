rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only authenticated users can upload and delete their own logos
    match /users/{userId}/logos/{qrId}.png {
      allow read: if true; // Publicly readable for scanning and rendering
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024 // 2MB limit
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
