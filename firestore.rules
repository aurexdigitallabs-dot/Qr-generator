rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated users can access their own document subcollection
    match /users/{userId}/qrcodes/{qrId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Strict field validation on writes
      allow create, update: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.type in ['url', 'text', 'email', 'phone', 'whatsapp', 'wifi', 'vcard', 'instagram', 'youtube', 'maps', 'sms']
        && request.resource.data.encodedString is string
        && request.resource.data.encodedString.size() <= 4096;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
